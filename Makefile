SRCS = $(wildcard *.c) #переменная для исходников с маской, чтобы брать все файлы с расширением *.c
OBJS = $(SRCS:.c=.o)   #переменная для объектных файлов, где за имя берётся имя исходяника

all: release

release: $(OBJS)           #линковка
	gcc $(OBJS) -o test_mmio

%.o: %.c               #создание объектных файлов
	gcc -c $^ -o $@

clean:                 #цель, которая очищает каталог от объектных файлов и слинкованного 
	rm -f $(OBJS) test_mmio
